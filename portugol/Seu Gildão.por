programa
{
funcao inicio()
{
inteiro pessoas
real carne, cerveja, agua, refri

escreva("Informe o número de pessoas para o churrasco: ")
leia(pessoas)

carne = pessoas * 0.5
cerveja = pessoas * 1.0
agua = pessoas * 0.5
refri = pessoas * 0.2

escreva(" Quantidades necessárias ")
escreva("Carne: ", carne, " kg")
escreva("Cerveja: ", cerveja, " L")
escreva("Água: ", agua, " L")
escreva("Refrigerante: ", refri, " L")
}
}
