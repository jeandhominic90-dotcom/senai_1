programa {
  funcao inicio() {
    // infos e vairiaves
    inteiro numero
     // ler os dados
     escreva("Digite o numero do dia: ")
     leia(numero)
     //processamento
     se(numero == 1){
      escreva("Domingo")
     }senao se(numero == 2){
       escreva("Segunda")
     }senao se(numero == 3){
      escreva("Terça")
     }senao se (numero == 4){
      escreva("Quarta")
     }senao se(numero == 5){
      escreva("Quinta")
     }senao se (numero == 6){
      escreva("Sexta")
     }senao se(numero == 7){
      escreva("Sábado")
     }
    
    //saida
  }
}
